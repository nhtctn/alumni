<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{jobPosting.title}} | Alumni Istanbul</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="shell narrow"><nav class="top-nav"><a class="brand" href="/">Alumni Istanbul</a></nav>
      <a class="back-link" href="/jobs">← All job postings</a>
      <section class="profile-card">
        <div class="profile-top">
          <span class="avatar avatar-large">{{initial jobPosting.title}}</span>
          <div>
            <p class="eyebrow">Job posting</p>
            <h1>{{jobPosting.title}}</h1>
            <p class="lede">{{jobPosting.company}}{{#if jobPosting.city}} · {{jobPosting.city}}{{/if}}</p>
          </div>
        </div>
        <div class="announcement-content">{{jobPosting.description}}</div>
        <dl class="details">
          <div><dt>Posting user</dt><dd>#{{jobPosting.userId}}</dd></div>
          <div><dt>Job posting ID</dt><dd>#{{jobPosting.id}}</dd></div>
        </dl>
        <div class="actions">
          <a class="button button-primary" href="/applications/job-postings/{{jobPosting.id}}/new">Apply</a>
          <a class="button button-secondary" href="/jobs/{{jobPosting.id}}/edit">Edit posting</a>
        </div>
      </section>
    </main>
  </body>
</html>
