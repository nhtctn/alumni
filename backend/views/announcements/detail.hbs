<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{announcement.title}} | Alumni Istanbul</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main class="shell narrow">
      <a class="back-link" href="/announcements">← All announcements</a>
      <section class="profile-card">
        <div class="profile-top">
          <span class="avatar avatar-large">{{initial announcement.title}}</span>
          <div>
            <p class="eyebrow">Announcement</p>
            <h1>{{announcement.title}}</h1>
          </div>
        </div>
        <div class="announcement-content">{{announcement.content}}</div>
        <dl class="details">
          <div><dt>Published</dt><dd>{{announcement.publishedAt}}</dd></div>
          <div><dt>Announcement ID</dt><dd>#{{announcement.id}}</dd></div>
        </dl>
        <div class="actions">
          <a class="button button-primary" href="/announcements/{{announcement.id}}/edit">Edit announcement</a>
          <form method="post" action="/announcements/{{announcement.id}}/delete">
            <button class="button button-danger" type="submit">Delete announcement</button>
          </form>
        </div>
      </section>
    </main>
  </body>
</html>
