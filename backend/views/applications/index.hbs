<!doctype html>
<html lang="en">
  <head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Applications | Alumni Istanbul</title><link rel="stylesheet" href="/styles.css"></head>
  <body>
    <main class="shell">
      <nav class="top-nav"><a class="brand" href="/">Alumni Istanbul</a><a class="back-link" href="/jobs">← Job postings</a></nav>
      <header class="page-header"><div><p class="eyebrow">Alumni Istanbul</p><h1>My applications</h1><p class="lede">Track the status of your job applications.</p></div><span class="badge">{{applications.length}} total</span></header>
      <section class="card">
        {{#if applications.length}}
          <div class="table-list">
            {{#each applications}}
              <div class="application-row"><div><strong>{{title}}</strong><small>{{company}}</small></div><span class="status-badge">{{status}}</span><div class="row-actions"><a class="text-link" href="/applications/{{id}}">Details</a><form method="post" action="/applications/{{id}}/delete"><input type="hidden" name="userId" value="{{../userId}}"><button class="button button-danger button-small" type="submit">Withdraw</button></form></div></div>
            {{/each}}
          </div>
        {{else}}
          <div class="empty-state"><span class="empty-icon">✦</span><h3>No applications yet</h3><p>Apply to a job posting to see it here.</p><a class="button button-secondary" href="/jobs">Browse jobs</a></div>
        {{/if}}
      </section>
    </main>
  </body>
</html>
